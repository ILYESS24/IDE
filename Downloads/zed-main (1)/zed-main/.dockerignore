# Ignore everything except what we need for the collab server build
# This prevents copying unnecessary files and reduces build context size

# Ignore all Downloads folders (they contain unrelated projects)
Downloads/

# Ignore target directory (will be built in Docker)
target/

# Ignore git
.git/
.gitignore

# Ignore documentation
docs/
*.md
!DEPLOIEMENT_RENDER.md
!DIAGNOSTIC_RENDER.md

# Ignore scripts
script/

# Ignore test files
**/test/
**/tests/
**/*_test.rs
**/*.test.*

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db

# Keep the main Dockerfile (needed for Render)
# Ignore other Dockerfiles
Dockerfile-collab
Dockerfile-distros
Dockerfile-cross

# Ignore compose files
docker-compose.yml
compose.yml

# Ignore nix files
*.nix
flake.lock

# Keep only what's needed for building
!Cargo.toml
!Cargo.lock
!crates/
!extensions/
!.cargo/
!rust-toolchain.toml

